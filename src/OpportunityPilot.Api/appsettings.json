{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Postgres",
    "MigrateOnStartup": false
  },
  "ConnectionStrings": {
    "Main": ""
  },
  "Auth": {
    "SupabaseUrl": "",
    "Audience": "authenticated",
    "DevBypass": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Features": {
    "GeminiEnabled": false,
    "MongoArchiveEnabled": false,
    "GmailEnabled": false
  },
  "Ai": {
    "Mode": "Rules",
    "GeminiModel": "gemini-3.8-flash",
    "AllowPaidUsage": false,
    "MaxCallsPerRun": 12,
    "MaxOutputTokens": 1500
  }
}
